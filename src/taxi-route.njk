---
pagination:
  data: taxiPages.routes
  size: 1
  alias: r
permalink: "{{ r.url }}"
eleventyExcludeFromCollections: true
---
{#- Les pages trajet de VIP Taxi Lanta sur un seul gabarit, identité « Laque et or » (10.11.2026).
    Données : taxiPages.js (products/taxi). Une donnée absente ne s'affiche pas (une durée inconnue, par exemple).
    Prix d'appel de la grille VIP Taxi Lanta (« From … THB ») quand il existe, sinon « Price on WhatsApp ». Réservation par la feuille (booking.js, variante taxi, aller ou retour). -#}
{% import "components/taxi.njk" as tx %}
{% from "components/booking.njk" import bookingSheet %}
{%- set T = taxiPages -%}
{%- set pair = r.from + " to " + r.to -%}
{%- set fallback = tx.waHref(T.contact.number, r.fallback) -%}
<!DOCTYPE html>
<html lang="en-GB" data-refonte data-brand="vip">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ r.seo.title }}</title>
<meta name="description" content="{{ r.seo.metaDescription }}">
<meta name="robots" content="index, follow, max-image-preview:large">
<link rel="canonical" href="{{ site.url }}{{ r.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="VIP Taxi Lanta">
<meta property="og:title" content="{{ r.seo.title }}">
<meta property="og:description" content="{{ r.seo.metaDescription }}">
<meta property="og:url" content="{{ site.url }}{{ r.url }}">
<meta property="og:image" content="{{ site.url }}/images/taxi/og-taxi.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="VIP Taxi Lanta, Mr. Brown, private taxis and minivans">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" sizes="32x32" href="/images/taxi/icon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/images/taxi/apple-touch-icon.png">
<meta name="theme-color" content="#1B130D">
<link rel="preload" as="font" type="font/woff2" href="/css/fonts/chonburi-400-normal-latin.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/css/fonts/bai-jamjuree-400-normal-latin.woff2" crossorigin>
<link rel="stylesheet" href="/css/booking.css?v={{ build.v }}">
<link rel="stylesheet" href="/css/vip-taxi.css?v={{ build.v }}">
<script>document.documentElement.classList.add("js");</script>
{%- for j in r.jsonLd %}
<script type="application/ld+json">{{ j | jsonld | safe }}</script>
{%- endfor %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{{ tx.top(T.contact) }}
<main id="main" class="is-route">
<section class="hero hero--route" aria-labelledby="h1">
  <div class="wrap hero-in">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/taxi/"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7"/></svg><span>All routes</span></a></nav>
    <div class="cart" data-frame="">
      {%- if r.code %}<p class="c-code"><span class="sr-only">Airport code </span>{{ r.code }}</p>{% endif %}
      {%- if r.h1Tail %}
      <h1 id="h1" class="cart-h1"><span class="c-from">{{ r.from }}</span> <span class="c-word">to</span> <span class="c-to">{{ r.to }}</span><span class="c-tail"> {{ r.h1Tail }}</span></h1>
      {%- else %}
      <h1 id="h1" class="cart-h1 cart-h1--plain">{{ r.h1 }}</h1>
      {%- endif %}
      {%- if r.drive %}<p class="c-drive">{{ r.drive | capitalize }}<span class="sr-only"> by road</span></p>{% endif %}
    </div>
    <div class="route-lead">
      <p class="lead">{{ r.lead | taxiLinks | safe }}</p>
      <div class="hero-act">
        <a class="btn btn--gold" href="{{ fallback }}" data-book="">Check availability</a>
        <p class="hero-note">{% if r.price %}<span class="hero-price">{{ r.price.label }}</span> per vehicle, cash to the driver.{% else %}Price on WhatsApp.{% endif %}</p>
        {{ tx.googleLine(T.rating) }}
      </div>
    </div>
  </div>
</section>

<section class="detail" aria-labelledby="h-detail">
  <div class="wrap detail-in">
    <div class="detail-text">
      <h2 id="h-detail">How this transfer works</h2>
      {%- if r.body.length %}
      <div class="prose">{% for para in r.body %}<p>{{ para | taxiLinks | safe }}</p>{% endfor %}</div>
      {%- endif %}
      {%- if r.pricePoints.length %}
      <h3 class="pp-h" id="h-points">Price by place</h3>
      <dl class="pp" aria-labelledby="h-points">
        {%- for x in r.pricePoints %}
        <div><dt>{% if x.url %}<a href="{{ x.url }}">{{ x.label }}</a>{% else %}{{ x.label }}{% endif %}</dt><dd><b>{{ x.text }}</b> per vehicle</dd></div>
        {%- endfor %}
      </dl>
      {%- endif %}
      <dl class="why why--route">
        {%- for x in r.how %}
        <div><dt>{{ x.title }}</dt><dd>{{ x.text }}</dd></div>
        {%- endfor %}
      </dl>
      {#- Une ou deux questions : elles restent ici plutôt que d'ouvrir une section presque vide. -#}
      {%- if r.faq.length and r.faq.length < 3 %}
      <h3 class="qa-inline" id="h-faq">Questions<span class="sr-only"> about {{ pair }}</span></h3>
      {{ tx.faq(r.faq) }}
      {%- endif %}
    </div>
    {{ tx.arch("/images/taxi/van-seats.webp", "Minivan interior with diamond-stitched tan leather seats and a lit ceiling", 900, 675, cls="arch arch--still", draw=false) }}
  </div>
</section>

{%- if r.faq.length >= 3 %}
<section class="qa" aria-labelledby="h-faq">
  <div class="wrap qa-in">
    <h2 id="h-faq">Questions<span class="sr-only"> about {{ pair }}</span></h2>
    {{ tx.faq(r.faq) }}
  </div>
</section>
{%- endif %}

{%- if r.others.length %}
<section class="others" aria-labelledby="h-others">
  <div class="wrap">
    <div class="sec-head"><h2 id="h-others">Other routes in {{ r.region }}</h2></div>
    <ul class="rr-list rr-list--wide">{% for o in r.others %}{{ tx.routeRow(o) }}{% endfor %}</ul>
    <p class="all-routes"><a class="link-ink" href="/taxi/#routes">See all routes</a></p>
  </div>
</section>
{%- endif %}

{{ tx.secretAside(taxi.tours, true) }}
</main>
{{ tx.footer(site, T.contact) }}
{{ tx.vbar("Check availability", fallback, r.price) }}
{{ bookingSheet(r.booking, T.contact) }}
<script src="/js/booking.js?v={{ build.v }}" defer></script>
<script src="/js/vip-taxi.js?v={{ build.v }}" defer></script>
</body>
</html>
