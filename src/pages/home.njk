---
permalink: /
---
{#- Accueil de Secret Travel & Tour (étape 3) : ce que fait le comptoir de Sala Dan, les départs du jour,
    les excursions, les activités, les transferts, la location et le comptoir. Textes : src/_data/home.json. -#}
{% import "components/stt.njk" as stt %}
{%- set h = pages.home -%}
{%- set seo = h.seo -%}
{%- set pageUrl = "/" -%}
{%- set jsonLd = pages.jsonLd.home -%}
<!DOCTYPE html>
<html lang="en-GB" data-refonte>
<head>
{% include "stt-head.njk" %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{{ stt.header("", pages.contact, pages.emblem.header, site) }}
<main id="main" class="wrap">
  <div class="grid home-hero">
    <div class="c-5">
      <h1>{{ h.h1 }}</h1>
      <p class="lead">{{ h.lead }}</p>
      <div class="pg-actions">
        <a class="btn btn-sea" href="{{ stt.waHref(pages.contact.number) }}">Ask on WhatsApp</a>
        <a class="link-wa" href="tel:{{ pages.contact.e164 }}">{{ pages.contact.phoneDisplay }}</a>
      </div>
    </div>
    <div class="c-7">{{ stt.departures(h.departures) }}</div>
  </div>

  <section class="pg-sec" id="boat-trips" aria-labelledby="h-boats">
    <h2 id="h-boats">{{ h.boats.title }}</h2>
    <ul class="grid cards">{% for c in h.boatCards %}<li>{{ stt.productCard(c, false) }}</li>{% endfor %}</ul>
  </section>

  <section class="pg-sec" id="activities" aria-labelledby="h-acts">
    <h2 id="h-acts">{{ h.activities.title }}</h2>
    <ul class="grid cards">{% for c in h.activityCards %}<li>{{ stt.productCard(c, false) }}</li>{% endfor %}</ul>
  </section>

  {%- if h.transfers.length %}
  <section class="pg-sec" id="transfers" aria-labelledby="h-transfers">
    <h2 id="h-transfers">{{ h.transfersTitle }}</h2>
    <ul class="grid home-list">
      {%- for i in h.transfers %}
      <li class="c-4"><h3>{% if i.href %}<a href="{{ i.href }}">{{ i.title }}</a>{% else %}{{ i.title }}{% endif %}</h3><p>{{ i.text }}</p></li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}

  <div class="grid pg-sec pg-two">
    {%- if h.rental %}
    <section class="c-6" aria-labelledby="h-rental">
      <h2 id="h-rental"><a href="/tours/rental/">{{ h.rental.title }}</a></h2>
      <p>{{ h.rental.text }}</p>
      {%- if h.rentalPrice %}<p class="home-price">from <span class="card-amount">{{ h.rentalPrice.amount }}</span> {{ h.rentalPrice.unit }}</p>{% endif %}
    </section>
    {%- endif %}
    <section class="c-6" aria-labelledby="h-desk">
      <h2 id="h-desk">{{ h.desk.title if h.desk else "Our desk" }}</h2>
      {%- if h.desk and h.desk.text %}<p>{{ h.desk.text }}</p>{% endif %}
      <p class="home-desk">{{ site.brands.secret.address.display }}{% if site.brands.secret.maps %} <a class="foot-link" href="{{ site.brands.secret.maps }}">Open in Google Maps</a>{% endif %}</p>
    </section>
  </div>
</main>
{{ stt.footer(site, pages.contact, pages.emblem.footer) }}
<script src="/js/ui.js?v={{ build.v }}" defer></script>
</body>
</html>
