---
permalink: /
---
{#- Accueil, design v3 (PROMPT-DESIGN-V3.md §3.1). Fonds : blanc, sable, blanc, coquille, blanc, sable, blanc, coquille, footer. -#}
{% import "components/v3.njk" as v3 %}
{%- set h = v3data.home -%}
{%- set c = v3data.contact -%}
{%- set seo = h.seo -%}
{%- set pageUrl = "/" -%}
{%- set jsonLd = pages.jsonLd.home -%}
<!DOCTYPE html>
<html lang="en-GB" data-refonte>
<head>
{% include "v3-head.njk" %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{{ v3.header(c, v3data.emblem, site) }}
<main id="main">
  <section class="hero" aria-labelledby="h1">
    <div class="wrap">
      <div class="hero-text">
        <h1 id="h1">{{ h.h1 }}</h1>
        <p class="lead">{{ h.lead }}</p>
        <div class="hero-actions">
          <a class="btn btn--lg" href="/tours/#boat-trips">See boat trips {{ v3.arrow() }}</a>
          <a class="tlink" href="{{ v3.waHref(c.number) }}">Ask on WhatsApp</a>
        </div>
      </div>
      <div class="hero-photo">{{ v3.img(h.hero, "(min-width: 1024px) 50vw, 100vw", true) }}</div>
      <p class="hero-facts">{{ h.facts }}</p>
    </div>
  </section>

  <section class="sec" aria-labelledby="h-boats">
    <div class="wrap">
      <div class="sec-head"><h2 id="h-boats">Boat trips</h2><a class="tlink" href="/tours/#boat-trips">All {{ v3data.counts.boats | numwords }} boat trips {{ v3.arrow() }}</a></div>
      {{ v3.cards(h.featured) }}
    </div>
  </section>

  <section class="overlap bg-shell" aria-labelledby="h-transfers">
    <div class="overlap-photo">{{ v3.img(h.transfers.photo, "(min-width: 1024px) 50vw, 100vw") }}</div>
    <div class="overlap-panel">
      <h2 id="h-transfers">{{ h.transfers.title }}</h2>
      <p>{{ h.transfers.text }}</p>
      {{ v3.rules(h.transfers.routes) }}
      <div class="hero-actions"><a class="btn" href="/taxi/">All transfers {{ v3.arrow() }}</a><a class="tlink" href="/tours/speedboat/">Speedboat times</a></div>
    </div>
  </section>

  <section class="sec" aria-labelledby="h-acts">
    <div class="wrap">
      <div class="sec-head"><h2 id="h-acts">Island activities</h2><a class="tlink" href="/tours/#activities">All {{ v3data.counts.activities | numwords }} activities {{ v3.arrow() }}</a></div>
      {{ v3.cards(h.activities) }}
    </div>
  </section>

  <section class="sec bg-sand" aria-labelledby="h-how">
    <div class="wrap">
      <div class="sec-head"><h2 id="h-how">How booking works</h2></div>
      {{ v3.steps(h.steps) }}
    </div>
  </section>

  <section class="cta-band" aria-labelledby="h-final">
    <div class="cta-photo">{{ v3.img(h.final.photo, "(min-width: 1024px) 50vw, 100vw") }}</div>
    <div class="cta-text">
      <h2 id="h-final">{{ h.final.title }}</h2>
      <p>{{ h.final.text }}</p>
      <a class="btn" href="{{ v3.waHref(c.number) }}">Ask on WhatsApp {{ v3.arrow() }}</a>
    </div>
  </section>
</main>
{{ v3.footer(site, c, v3data.emblem, v3data.boats, v3data.activities) }}
{{ v3.waPill(c) }}
<script src="/js/v3.js?v={{ build.v }}" defer></script>
</body>
</html>
