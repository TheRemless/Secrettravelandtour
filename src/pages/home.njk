---
permalink: /
---
{#- Accueil, design v4 (prototype « mouvement » et liste de sorties). Tout est rendu au build ;
    v4.js et v4-home.js n'ajoutent que le comportement. -#}
{% import "components/v4.njk" as v4 %}
{% from "components/icons.njk" import icon %}
{%- set d = v4data -%}
{%- set h = d.home -%}
{%- set c = d.contact -%}
{%- set waText = "Hello, I have a question: " -%}
{%- set seo = h.seo -%}
{%- set pageUrl = "/" -%}
{%- set jsonLd = pages.jsonLd.home -%}
{%- set heroSizes = "(min-width: 900px) 58vw, 100vw" -%}
{%- set preloadImg = h.heroTrips[0].photo -%}
{%- set preloadSizes = heroSizes -%}
<!DOCTYPE html>
<html lang="en-GB" data-refonte data-page="home">
<head>
{% include "v4-head.njk" %}
</head>
<body>
{{ v4.header(c, d.emblem, "", waText) }}
<main id="main">

  {#- Premier écran du téléphone : titre, une phrase, photo basse et les trois sorties avec leur prix. Chaque ligne est
      un lien vers sa fiche ; sur bureau, le survol ou le focus d'une ligne montre sa photo. -#}
  <section class="wrap hero" aria-labelledby="h1">
    <div class="hero__text">
      <h1 id="h1">{{ h.h1 }}</h1>
      <p class="lead">{{ h.lead }}</p>
    </div>
    <figure class="hero__ph">
      <div class="hero__stack" data-hero-stack>
        {{ v4.photo(h.heroTrips[0].photo, heroSizes, true, "is-on", "trip-photo") }}
        {%- for t in h.heroTrips %}{% if not loop.first %}
        <template data-hero-tpl="{{ loop.index0 }}">{{ v4.photo(t.photo, heroSizes) }}</template>
        {%- endif %}{% endfor %}
      </div>
    </figure>
    <div class="hero__ctl">
      <ul class="hrows" data-hrows>
        {%- for t in h.heroTrips %}
        <li><a class="hrow press" href="{{ t.href }}" data-hero-i="{{ loop.index0 }}"{% if loop.first %} aria-current="true"{% endif %}>
          <span class="hrow__t"><b>{{ t.title }}</b><small>{{ t.promise | keephy | safe }}</small></span>
          <span class="hrow__p"><b>from {{ t.price.amount }}</b><small>{{ t.price.unit }}</small></span>
        </a></li>
        {%- endfor %}
      </ul>
      <a class="link hero__all" href="/tours/">See all trips and activities</a>
    </div>
  </section>

  {#- Réserver : un message WhatsApp suffit (Jérémy, 11.11.2026 : clair, peu de texte). Exemple illustratif. -#}
  <section class="sec sec--tight" id="how" aria-labelledby="how-h">
    <div class="wrap how">
      <div class="how__text">
        <h2 id="how-h">Your trip is one WhatsApp message away</h2>
        <p>Pick a trip and a day, send the message, and we reply with your pickup time.</p>
      </div>
      <figure class="chat" aria-label="Example of a booking on WhatsApp">
        <p class="chat__out">4 Islands, Saturday<br>2 adults, 1 child<br>Pimalai Resort<span class="chat__t">18:42 {{ v4.glyph("check") }}</span></p>
        <p class="chat__in">Confirmed! Pickup at 08:10.<span class="chat__t">18:51</span></p>
      </figure>
    </div>
  </section>

  {%- macro rail(id, title, href, linkText, items, what) %}
  <section class="sec sec--tight" id="{{ id }}" aria-labelledby="{{ id }}-h">
    <div class="wrap rail-wrap">
      <div class="sec__head"><h2 id="{{ id }}-h">{{ title }}</h2><a class="link" href="{{ href }}">{{ linkText }}</a></div>
      <div class="rail" data-rail tabindex="0" role="region" aria-label="{{ title }}, scroll sideways">
        {%- for t in items %}{{ v4.card(t, "(min-width: 1024px) 360px, (min-width: 700px) 45vw, 74vw", add=false) }}{% endfor %}
      </div>
      <div class="rail-ctl" data-rail-ctl hidden>
        <div class="rail-bar" aria-hidden="true"><i></i></div>
        <div class="arrows">
          <button class="arrow" type="button" data-rail-prev>{{ icon("chevron-left") }}<span class="sr">Previous {{ what }}</span></button>
          <button class="arrow" type="button" data-rail-next>{{ icon("chevron-right") }}<span class="sr">Next {{ what }}</span></button>
        </div>
      </div>
    </div>
  </section>
  {%- endmacro %}
  {{ rail("boat-trips", "Boat trips", "/tours/#boat-trips", "See all boat trips", h.boats, "boat trips") }}

  {{ rail("activities", "Activities", "/tours/#activities", "See all activities", h.activities, "activities") }}

  {#- Se déplacer : trois trajets en liens, le speedboat, la location et ses trois fourchettes. -#}
  {%- set ar = h.around -%}
  <section class="sec sec--tight" id="around" aria-labelledby="around-h">
    <div class="wrap">
      <h2 id="around-h">Getting here and around</h2>
      {%- if ar.transfers.speedboat %}
      <ul class="lrows">
        <li><a class="lrow press" href="{{ ar.transfers.speedboat.href }}"><span><b>{{ ar.transfers.speedboat.title }}</b><small>{{ ar.transfers.speedboat.text }}</small></span></a></li>
      </ul>
      {%- endif %}
      <div class="around">
        <div>
          <h3 id="tr-h">Private transfers</h3>
          <p class="around__lead">{{ ar.transfers.lead | replace(ar.transfers.vip, '<a class="link" href="/taxi/">' ~ ar.transfers.vip ~ '</a>') | safe }}</p>
          <ul class="lrows" aria-labelledby="tr-h">
            {%- for r in ar.transfers.routes %}
            <li><a class="lrow press" href="{{ r.href }}"><span><b>{{ r.name }}</b><small>{{ r.drive }}, both directions</small></span></a></li>
            {%- endfor %}
          </ul>
          <a class="link" href="/taxi/">All private transfers</a>
        </div>
        <div>
          <h3 id="rent-h">{{ ar.rental.title }}</h3>
          <p class="around__lead">Prices {{ ar.rental.unit }}.</p>
          <ul class="lrows" aria-labelledby="rent-h">
            {%- for k in ar.rental.cats %}
            <li><a class="lrow press" href="{{ ar.rental.href }}"><span><b>{{ k.label }}</b>{% if k.models %}<small>{{ k.models }}</small>{% endif %}</span><span class="lrow__p">{{ k.lo }} to {{ k.hi }} THB</span></a></li>
            {%- endfor %}
          </ul>
          <a class="link" href="{{ ar.rental.href }}">Every vehicle and its price</a>
        </div>
      </div>
    </div>
  </section>

  {{ v4.endBand(h.final, c) }}
</main>
{{ v4.footer(site, c, d.emblem, d.boats, d.activities, waText) }}
{{ v4.tripsRoot() }}
{{ v4.scripts(build, "home") }}
</body>
</html>
