---
permalink: /tours/
---
{#- Hub des sorties, design v4 : filtres type et tri (les cartes glissent à leur place), compteur, état dans l'adresse,
    comparateur avec tiroir. Les 13 cartes sont rendues au build, dans l'ordre des bateaux puis des activités. -#}
{% import "components/v4.njk" as v4 %}
{% from "components/icons.njk" import icon %}
{%- set d = v4data -%}
{%- set c = d.contact -%}
{%- set seo = d.hub.seo -%}
{%- set pageUrl = "/tours/" -%}
<!DOCTYPE html>
<html lang="en-GB" data-refonte data-page="hub">
<head>
{% include "v4-head.njk" %}
</head>
<body>
{{ v4.header(c, d.emblem, "boats") }}
<main id="main">
  <nav class="wrap crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><span aria-current="page">Tours</span></li></ol></nav>
  <div class="wrap top">
    <h1>{{ d.hub.h1 }}</h1>
    <p class="lead">{{ d.hub.lead }}</p>
  </div>
  <div class="bar" data-bar>
    <div class="wrap bar__in">
      <div class="seg" role="group" aria-label="Show" data-seg="type">
        <button type="button" value="all" aria-pressed="true">All</button>
        <button type="button" value="boat" aria-pressed="false">Boat trips</button>
        <button type="button" value="activity" aria-pressed="false">Activities</button>
      </div>
      <label class="sr" for="sort">Sort</label>
      <select class="sort" id="sort" data-sort><option value="">Suggested order</option><option value="asc">Lowest price first</option><option value="desc">Highest price first</option></select>
      <p class="hub-count" aria-live="polite"><span class="odo" data-odo="n">{{ d.counts.all }}</span> <span data-n-l>trips</span></p>
    </div>
  </div>
  <section class="wrap hub" aria-labelledby="hub-h">
    <h2 class="sr" id="hub-h">All trips</h2>
    <div class="grid" data-grid>
      {%- for t in d.boats %}{{ v4.card(t, eager=loop.first, compare=true, anchor="boat-trips" if loop.first else "") }}{% endfor %}
      {%- for t in d.activities %}{{ v4.card(t, compare=true, anchor="activities" if loop.first else "") }}{% endfor %}
    </div>
  </section>
  {{ v4.endBand(d.hub.final, c) }}
</main>
{{ v4.footer(site, c, d.emblem, d.boats, d.activities) }}
<div class="tray" data-tray aria-label="Trips to compare" role="region" hidden>
  <div class="tray__slots" data-slots></div>
  <p class="tray__txt" data-tray-t aria-live="polite"></p>
  <button class="btn btn--light press" type="button" data-cmp-go disabled>Compare</button>
  <button class="x x--dark" type="button" data-cmp-clear>{{ icon("close") }}<span class="sr">Clear the comparison</span></button>
</div>
<dialog class="cmpd" data-cmpd aria-labelledby="cmpd-h">
  <div class="cmpd__head"><h2 id="cmpd-h">Compare</h2><button class="x" type="button" data-close>{{ icon("close") }}<span class="sr">Close</span></button></div>
  <div class="cmpd__scroll" data-cmpd-t tabindex="0"></div>
</dialog>
{{ v4.tripsRoot() }}
{{ v4.scripts(build, "hub") }}
</body>
</html>
