---
permalink: /tours/4-islands/
---
{#- Page 4 Islands : gabarit commun des fiches (components/v4-product.njk), avec sa journée par bateau, ses photos et
    la carte du trajet sur bureau. Tout est rendu au build. -#}
{% import "components/v4.njk" as v4 %}
{% import "components/v4-product.njk" as vp %}
{% from "components/booking.njk" import bookingSheet %}
{%- set d = v4data -%}
{%- set f4 = d.four -%}
{%- set t = f4.page -%}
{%- set c = d.contact -%}
{%- set waText = t.ask -%}
{%- set seo = f4.seo -%}
{%- set pageUrl = "/tours/4-islands/" -%}
{%- set jsonLd = pages.jsonLd.fourIslands -%}
{%- set withBooking = true -%}
{%- set fallback = v4.waHref(c.number, t.fallback) -%}
{%- set preloadImg = f4.hero -%}
{%- set preloadSizes = "(min-width: 900px) 56vw, 100vw" -%}
<!DOCTYPE html>
<html lang="en-GB" data-refonte data-page="four">
<head>
{% include "v4-head.njk" %}
</head>
<body>
{{ v4.header(c, d.emblem, "islands", waText) }}
<main id="main">
  {{ vp.crumbs([{ label: "Home", href: "/" }, { label: "Islands", href: "/tours/#islands" }, { label: "4 Islands" }]) }}
  {{ vp.hero(t, c, fallback, t.single) }}
  {{ vp.pick(t, c) }}

  {#- Après les options : la journée du bateau choisi, ses photos et la carte du trajet (bureau ; sur téléphone la
      journée suffit, les noms de la carte seraient illisibles), puis les infos pratiques en onglets. Une seule
      visionneuse pour toutes les photos. Sur bureau, l'étape pointée allume l'île sur la carte (v4-four.js). -#}
  <div class="pc" data-gal data-gal-lb>
  <section class="sec sec--sand trip" id="day" aria-labelledby="day-h"><div class="wrap">
    <div class="trip__head">
      <div class="trip__t">
        <h2 id="day-h">{{ f4.day.title }}</h2>
        {%- for b in f4.day.boats %}
        <p class="trip__note" data-day-for="{{ b.boat }}"{% if not loop.first %} hidden{% endif %}>{{ b.title }}. {{ b.note }}</p>
        {%- endfor %}
      </div>
      <div class="seg trip__seg" role="group" aria-label="Choose the boat" data-boat-seg hidden>
        {%- for b in f4.day.boats %}<button type="button" data-day-btn="{{ b.boat }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ b.boat | capitalize }}</button>{% endfor %}
      </div>
    </div>
    <div class="trip__media trip__media--map">
      {{ vp.mosaic(f4.photos.mos, 0, f4.photos.all.length, "(min-width: 900px) 400px, 72vw", "(min-width: 900px) 200px, 72vw") }}
      <figure class="map" id="route-map" data-map>
        {%- set m = f4.map -%}
        <svg viewBox="0 0 {{ m.W }} {{ m.H }}" role="img" aria-labelledby="map-t">
          <title id="map-t">Sketch map of the 4 Islands route</title>
          <rect class="map__sea" width="{{ m.W }}" height="{{ m.H }}"/>
          {%- for l in m.land %}<path class="map__land{% if l.main %} map__land--main{% endif %}" d="{{ l.d }}"/>{% endfor %}
          {%- for boat, r in m.routes %}
          <g class="map__route" data-map-route="{{ boat }}" data-start-x="{{ r.start.x }}" data-start-y="{{ r.start.y }}"{% if boat != "longtail" %} hidden{% endif %}>
            {%- for s in r.segs %}<path class="map__ghost" d="{{ s }}"/>{% endfor %}
            {%- for s in r.segs %}<path class="map__lit" data-seg="{{ loop.index0 }}" d="{{ s }}" pathLength="1"/>{% endfor %}
            {%- for s in r.stops %}<circle class="map__stop" data-stop="{{ s.name }}" cx="{{ s.x }}" cy="{{ s.y }}" r="7"/>{% endfor %}
          </g>
          {%- endfor %}
          <circle class="map__stop map__stop--pier" data-pier cx="{{ m.pier.x }}" cy="{{ m.pier.y }}" r="6"/>
          {%- for l in m.labels %}<text class="map__lbl{% if l.big %} map__lbl--big{% endif %}{% if l.gone %} is-gone{% endif %}" data-lbl="{{ l.text }}" x="{{ l.x }}" y="{{ l.y }}" text-anchor="{{ l.anchor }}">{{ l.text }}</text>{% endfor %}
          <line class="map__scale" x1="{{ m.scale.x1 }}" y1="{{ m.scale.y }}" x2="{{ m.scale.x2 }}" y2="{{ m.scale.y }}"/>
          <text class="map__scale-t" x="{{ m.scale.x2 }}" y="{{ m.scale.y - 8 }}" text-anchor="end">{{ m.scale.km }} km</text>
          <g class="map__boat" data-map-boat transform="translate({{ m.pier.x }} {{ m.pier.y }})"><path d="M-12 -1 L12 -1 L8 6 L-8 6 Z"/><path d="M0 -1 V-12 L7 -4 Z"/></g>
        </svg>
        <figcaption>Sketch map, not for navigation. Positions are approximate. Island outlines © OpenStreetMap contributors.</figcaption>
      </figure>
    </div>
    {%- for b in f4.day.boats %}
    <ol class="route route--{{ b.steps.length }}" data-tl="{{ b.boat }}"{% if not loop.first %} hidden{% endif %}>
      {%- for s in b.steps %}
      <li class="route__step" data-place="{{ s.place }}"><time class="{{ 'fixed' if s.fixed }}">{% if not s.fixed %}≈ {% endif %}{{ s.t }}</time><b>{{ s.place }}</b><p>{{ s.text }}</p></li>
      {%- endfor %}
    </ol>
    <button type="button" class="route__more" data-more hidden>Show the whole day</button>
    {%- endfor %}
  </div></section>
  {{ vp.know(t, f4.photos) }}
  </div>
  {{ vp.related(t.related) }}
</main>
{{ v4.footer(site, c, d.emblem, d.boats, d.activities, waText) }}
{{ vp.dock(t.price, fallback, t.single) }}
{{ bookingSheet(t.booking, c) }}
<script type="application/json" id="four-data">{{ f4.json | dump | safe }}</script>
{{ v4.tripsRoot() }}
<script src="/js/v4-price.js?v={{ build.v }}" defer></script>
<script src="/js/booking.js?v={{ build.v }}" defer></script>
{{ v4.scripts(build, "product") }}
<script src="/js/v4-four.js?v={{ build.v }}" defer></script>
</body>
</html>
