---
permalink: /tours/speedboat/
---
{#- Speedboat, design v4 : la grille des départs tient lieu d'options. Chaque arrêt ouvre la feuille sur son trajet
    et son heure ; le prix des billets n'est pas sur le site (Price on WhatsApp). -#}
{% import "components/v4.njk" as v4 %}
{% import "components/v4-product.njk" as vp %}
{% from "components/booking.njk" import bookingSheet %}
{%- set d = v4data -%}
{%- set t = d.speedboatPage -%}
{%- set c = d.contact -%}
{%- set seo = t.seo -%}
{%- set pageUrl = t.url -%}
{%- set jsonLd = t.jsonLd -%}
{%- set waText = t.ask -%}
{%- set fallback = v4.waHref(c.number, t.fallback) -%}
<!DOCTYPE html>
<html lang="en-GB" data-refonte data-page="product">
<head>
{% include "v4-head.njk" %}
</head>
<body>
{{ v4.header(c, d.emblem, t.nav, waText) }}
<main id="main">
  {{ vp.crumbs([{ label: "Home", href: "/" }, { label: t.name }]) }}
  {{ vp.hero(t, c, fallback, "", "Book a seat") }}

  <section class="sec sec--sand" id="options" aria-labelledby="opt-h">
    <div class="wrap">
      <div class="sec__head"><h2 id="opt-h">Times and prices</h2><p class="sec__note">Ticket prices are not on the site yet: we reply with the fare on WhatsApp.{% if t.checkIn %} {{ t.checkIn }}.{% endif %}</p></div>
      {#- Une ligne par destination, toutes ses heures de départ, quelle que soit la compagnie (décision client du 09.11.2026). -#}
      <h3 class="sb__h">From Koh Lanta</h3>
      <ol class="sb sb--back">
        {%- for r in t.dests %}
        <li class="sb__run">
          <p class="sb__t"><b>{{ r.place }}</b>{% for n in r.notes %}<small>{{ n }}</small>{% endfor %}</p>
          <ul class="sb__stops">
            {%- for dp in r.deps %}
            <li><a class="sb__stop press" href="{{ v4.waHref(c.number, 'Speedboat request: Koh Lanta to ' + r.place + '\nDeparture: ' + dp.time + '\nDate: \nPage: ' + t.booking.page) }}" data-book="" data-sb-route="{{ r.route }}" data-sb-dep="{{ dp.dep }}"><b>{{ dp.time }}</b>{% if dp.arrives %}<span>arrives {{ dp.arrives }}</span>{% endif %}{% if dp.season %}<span>{{ dp.season }}</span>{% endif %}<span class="sr">: book the {{ dp.time }} boat to {{ r.place }}</span></a></li>
            {%- endfor %}
          </ul>
        </li>
        {%- endfor %}
      </ol>
      <h3 class="sb__h">To Koh Lanta</h3>
      <ol class="sb sb--back">
        {%- for run in t.back %}
        {%- for r in run.rows %}
        <li class="sb__run">
          <p class="sb__t"><b>{{ r.place }}</b>{% if r.note %}<small>{{ r.note }}</small>{% endif %}{% if loop.first and run.via.length %}<small>via {{ run.via | join(", ") }}</small>{% endif %}{% if run.season %}<small>{{ run.season }}</small>{% endif %}</p>
          <ul class="sb__stops">
            {%- for dp in r.deps %}
            <li><a class="sb__stop press" href="{{ v4.waHref(c.number, 'Speedboat request: ' + r.place + ' to Koh Lanta\nDeparture: ' + dp.time + '\nDate: \nPage: ' + t.booking.page) }}" data-book="" data-sb-route="{{ r.route }}" data-sb-dep="{{ dp.dep }}"><b>{{ dp.time }}</b><span>Koh Lanta {{ dp.arrives }}</span><span class="sr">: book the {{ dp.time }} boat from {{ r.place }}</span></a></li>
            {%- endfor %}
          </ul>
        </li>
        {%- endfor %}
        {%- endfor %}
      </ol>
      {%- if t.seasons.length %}<ul class="sb__notes">{% for x in t.seasons %}<li>{{ x }}</li>{% endfor %}</ul>{% endif %}
    </div>
  </section>

  {%- if t.beforeBook.length or t.faq.length %}{{ vp.bybFaq(t.beforeBook, t.faq) }}{% endif %}
  {{ vp.related(t.related) }}
</main>
{{ v4.footer(site, c, d.emblem, d.boats, d.activities, waText) }}
{{ vp.dock(null, fallback, "", "Book a seat") }}
{{ bookingSheet(t.booking, c) }}
{{ v4.tripsRoot() }}
<script src="/js/booking.js?v={{ build.v }}" defer></script>
{{ v4.scripts(build, "product") }}
</body>
</html>
