---
permalink: /tours/rental/
---
{#- Location (00-BRIEF §6.3) : véhicules et prix par jour, feuille avec premier et dernier jour.
    Les conditions (permis, caution, passeport, casque, livraison) s'afficheront quand le client les donnera. -#}
{% import "components/stt.njk" as stt %}
{% from "components/booking.njk" import bookingSheet %}
{%- set t = pages.rental -%}
{%- set seo = t.seo -%}
{%- set pageUrl = t.url -%}
{%- set jsonLd = pages.jsonLd.rental -%}
{%- set fallback = stt.waHref(pages.contact.number, t.fallback) -%}
<!DOCTYPE html>
<html lang="en-GB" data-refonte>
<head>
{% include "stt-head.njk" %}
</head>
<body class="has-mbar">
<a class="skip" href="#main">Skip to content</a>
{{ stt.header("rental", pages.contact, pages.emblem.header, site) }}
<main id="main" class="wrap">
  <div class="grid pg-hero">
    <div class="c-7">
      {{ stt.breadcrumb([{ label: "Home", href: "/" }, { label: t.name }]) }}
      <h1>{{ t.h1 }}</h1>
      <p class="lead">{{ t.lead }}</p>
      <div class="pg-actions">
        <a class="btn btn-primary" href="{{ fallback }}" data-book="{{ t.price.option if t.price else '' }}">Check availability</a>
        <a class="link-wa" href="{{ stt.waHref(pages.contact.number) }}">Ask on WhatsApp</a>
      </div>
    </div>
    <div class="c-5">
      <div class="ticket ticket--rental" role="group" aria-label="Rental at a glance">
        <dl class="ticket-main">
          {%- for f in t.facts %}{% if f.label != "Fleet" %}<div class="ticket-cell--wide"><dt>{{ f.label }}</dt><dd>{{ f.value }}</dd></div>{% endif %}{% endfor %}
        </dl>
        {%- if t.price %}
        <div class="ticket-stub"><p class="stub-price"><span class="stub-label">From</span><span class="stub-amount">{{ t.price.amount }}</span><span class="stub-unit">{{ t.price.unit }}</span></p></div>
        {%- endif %}
      </div>
    </div>
  </div>

  <section class="pg-sec" aria-labelledby="h-fleet">
    <h2 id="h-fleet">Vehicles and daily rates</h2>
    {{ stt.rentalTable(t.groups) }}
    <ul class="rent-ask">
      {%- for g in t.groups %}<li><button class="btn btn-line" type="button" data-book="{{ g.id }}">Ask for {{ g.title | lower }}</button></li>{% endfor %}
    </ul>
  </section>

  <div class="grid pg-sec pg-two">
    <div class="c-6">{{ stt.beforeBook(t.beforeBook) }}</div>
    <div class="c-6">{{ stt.whoRuns(pages.who, 2, "Who you rent from", false) }}</div>
  </div>
</main>
{{ stt.footer(site, pages.contact, pages.emblem.footer) }}
{{ stt.mobileBar(t.price, fallback) }}
{{ bookingSheet(t.booking, pages.contact) }}
<script src="/js/booking.js?v={{ build.v }}" defer></script>
<script src="/js/ui.js?v={{ build.v }}" defer></script>
</body>
</html>
