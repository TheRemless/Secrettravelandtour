{#- En-tête des pages Secret de la refonte. Variables : seo {title, metaDescription}, pageUrl, ogImage (chemin), jsonLd (liste). -#}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ seo.title }}</title>
<meta name="description" content="{{ seo.metaDescription }}">
<link rel="canonical" href="{{ site.url }}{{ pageUrl }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Secret Travel &amp; Tour">
<meta property="og:title" content="{{ seo.title }}">
<meta property="og:description" content="{{ seo.metaDescription }}">
<meta property="og:url" content="{{ site.url }}{{ pageUrl }}">
<meta property="og:image" content="{{ site.url }}{{ ogImage or '/images/secret/og-secret-v4.jpg' }}">
{%- if not ogImage %}
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Secret Travel &amp; Tour, boat trips, activities and transfers on Koh Lanta">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<link rel="preload" as="font" type="font/woff2" href="/css/fonts/archivo-latin-wdth-normal.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/css/fonts/atkinson-hyperlegible-next-latin-wght-normal.woff2" crossorigin>
<link rel="stylesheet" href="/css/stt.css?v={{ build.v }}">
<link rel="stylesheet" href="/css/booking.css?v={{ build.v }}">
<link rel="icon" type="image/png" sizes="32x32" href="/images/secret/favicon-32.png">
<link rel="icon" type="image/png" sizes="512x512" href="/images/secret/favicon-512.png">
<link rel="apple-touch-icon" sizes="180x180" href="/images/secret/favicon-180.png">
<meta name="theme-color" content="#F5F0E6">
{%- for j in jsonLd %}
<script type="application/ld+json">{{ j | jsonld | safe }}</script>
{%- endfor %}
<script>document.documentElement.classList.add("js");</script>
