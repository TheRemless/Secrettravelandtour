{#- Composants de la direction « Koh Lanta vue du bateau » (maquettes du 03.11.2026). Importer avec :
      {% import "components/v2.njk" as v2 %}
    Données en paramètres uniquement. Photo absente : aplat chaud et titre en grand, jamais un cadre vide. -#}
{% from "components/icons.njk" import icon %}

{% macro waHref(number, text) -%}
https://wa.me/{{ number }}{% if text %}?text={{ text | urlencode }}{% endif %}
{%- endmacro %}

{#- Image responsive (view.responsive) : affichée au plus à sa largeur native. -#}
{% macro img(p, sizes, eager=false, cls="") -%}
<picture>
  {%- if p.avif %}<source type="image/avif" srcset="{{ p.avif }}" sizes="{{ sizes }}">{% endif %}
  {%- if p.webp %}<source type="image/webp" srcset="{{ p.webp }}" sizes="{{ sizes }}">{% endif %}
  <img eleventy:ignore class="{{ cls }}" src="{{ p.fallback or p.src }}" alt="{{ p.alt }}" width="{{ p.width }}" height="{{ p.height }}"{% if eager %} fetchpriority="high"{% else %} loading="lazy"{% endif %} decoding="async">
</picture>
{%- endmacro %}

{% macro header(contact, em, current="") %}
<header class="hd">
  <div class="wrap">
    <a class="brand" href="/"><picture><source type="image/avif" srcset="{{ em.avif }}"><img eleventy:ignore src="{{ em.src }}" srcset="{{ em.webp }}" width="{{ em.width }}" height="{{ em.height }}" alt=""></picture><span><span class="brand-name">Secret Travel &amp; Tour</span><span class="brand-place">Sala Dan, Koh Lanta</span></span></a>
    <nav class="nav" aria-label="Main">
      <ul>
        <li><a href="/#boat-trips"{% if current == "boats" %} aria-current="page"{% endif %}>Boat trips</a></li>
        <li><a href="/#activities">Activities</a></li>
        <li><a href="/#transfers">Transfers</a></li>
        <li><a href="/tours/rental/">Rental</a></li>
      </ul>
    </nav>
    <a class="btn" href="{{ waHref(contact.number) }}">{{ icon("whatsapp") }}<span>WhatsApp</span></a>
  </div>
</header>
{% endmacro %}

{#- Carte : grande photo 3:2 ou aplat chaud avec le titre, puis titre, promesse et prix. Toute la carte est le lien. -#}
{% macro card(c, tone=1, sizes="(min-width: 64rem) 400px, (min-width: 40rem) 50vw, 100vw") %}
<a class="card{% if not c.photo %} card--plain{% endif %}" href="{{ c.href }}">
  <div class="card-media">
    {%- if c.photo %}{{ img(c.photo, sizes) }}{% else %}<div class="card-plain tone-{{ tone }}" aria-hidden="true">{{ c.title }}</div>{% endif %}
  </div>
  <div class="card-body">
    <h3 class="card-title">{{ c.title }}</h3>
    {% if c.promise %}<p class="card-promise">{{ c.promise }}</p>{% endif %}
    <p class="card-price">{% if c.price %}from <b>{{ c.price.amount }}</b>{{ c.price.unit }}{% else %}Price on WhatsApp{% endif %}</p>
  </div>
</a>
{% endmacro %}

{#- Ligne de faits clés : une ligne de texte, séparateurs fins. items : [{label, value}] -#}
{% macro facts(items) -%}
<ul class="facts">{% for f in items %}{% if f.value %}<li>{{ f.label }} <b>{{ f.value }}</b></li>{% endif %}{% endfor %}</ul>
{%- endmacro %}

{#- Journée : points et trait fin, lieux en serif ; heures fixes en gras, les autres avec « ≈ ». -#}
{% macro day(steps, note) %}
<ol class="day">
  {%- for s in steps %}
  <li class="{% if s.fixed %}day-fixed{% endif %}"><span class="day-t">{% if s.approx %}≈ {% endif %}{{ s.t }}</span><span><span class="day-place">{{ s.place or s.text }}</span>{% if s.place %}<span class="day-detail">{{ s.detail }}</span>{% endif %}</span></li>
  {%- endfor %}
</ol>
{%- if note %}<p class="note">{{ note }}</p>{% endif %}
{% endmacro %}

{#- Options : la colonne entière ouvre la feuille avec l'option choisie (booking.js, data-book). -#}
{% macro options(list) %}
<ul class="opts">
  {%- for o in list %}
  <li>
    <button class="opt" type="button" data-book="{{ o.id }}" aria-pressed="false" aria-label="Check availability for {{ o.title }}">
      <span class="opt-title">{{ o.title }}</span>
      {%- if o.note %}<span class="opt-note">{{ o.note }}</span>{% endif %}
      <span class="opt-rows">{% for r in o.rows %}<span class="opt-row"><span>{{ r.label }}</span><b>{{ r.price }}</b></span>{% endfor %}</span>
      <span class="opt-cta">Check availability</span>
    </button>
  </li>
  {%- endfor %}
</ul>
{% endmacro %}

{% macro faq(items) %}
<div class="faq">
  {%- for f in items %}
  <details><summary>{{ f.q }}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" d="M12 5v14M5 12h14"/></svg></summary><div class="answer"><p>{{ f.a }}</p></div></details>
  {%- endfor %}
</div>
{% endmacro %}

{% macro mobileBar(price, href, option="") %}
<div class="mbar">
  <p>{% if price %}from <b>{{ price.amount }}</b>{% if price.short %} / {{ price.short }}{% endif %}{% else %}Price on WhatsApp{% endif %}</p>
  <a class="btn" href="{{ href }}" data-book="{{ option }}">Check availability</a>
</div>
{% endmacro %}

{% macro footer(site, contact, em) %}
{%- set b = site.brands.secret -%}
<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand"><span class="pastille"><picture><source type="image/avif" srcset="{{ em.avif }}"><img eleventy:ignore src="{{ em.src }}" srcset="{{ em.webp }}" width="{{ em.width }}" height="{{ em.height }}" alt="" loading="lazy"></picture></span><p class="foot-name">Secret Travel &amp; Tour<span>Sala Dan, Koh Lanta</span></p></div>
      <div><p class="foot-title">Our desk</p><p>{{ b.address.display }}</p>{% if b.maps %}<a class="link" href="{{ b.maps }}">Open in Google Maps</a>{% endif %}</div>
      <div><p class="foot-title">WhatsApp</p><a class="link" href="{{ waHref(contact.number) }}">{{ contact.phoneDisplay }}</a></div>
    </div>
    <div class="foot-legal">
      <p>Operated by {{ site.operator.name }}</p>
      <a href="/terms/">Booking terms</a><a href="/legal/">Legal notice</a><a href="/privacy/">Privacy</a>
    </div>
  </div>
</footer>
{% endmacro %}
