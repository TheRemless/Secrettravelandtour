{#- Composants du design v3 (PROMPT-DESIGN-V3.md §2.3). Importer avec :
      {% import "components/v3.njk" as v3 %}
    Données en paramètres uniquement (src/_data/v3.js). Rien n'est jamais posé sur une photo. -#}
{% from "components/icons.njk" import icon %}

{% macro waHref(number, text) -%}
https://wa.me/{{ number }}{% if text %}?text={{ text | urlencode }}{% endif %}
{%- endmacro %}

{%- macro arrow() -%}
<svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endmacro -%}

{#- Image : AVIF puis WebP, srcset 480 à 2000 (jamais au-delà de la taille native), width/height réels,
    object-position choisi image par image. -#}
{% macro img(p, sizes, eager=false, cls="") -%}
<picture>
  {%- if p.avif %}<source type="image/avif" srcset="{{ p.avif }}" sizes="{{ sizes }}">{% endif %}
  {%- if p.webp %}<source type="image/webp" srcset="{{ p.webp }}" sizes="{{ sizes }}">{% endif %}
  <img eleventy:ignore class="{{ cls }}" src="{{ p.fallback or p.src }}" alt="{{ p.alt }}" width="{{ p.width }}" height="{{ p.height }}"{% if p.position %} style="object-position: {{ p.position }}"{% endif %}{% if eager %} fetchpriority="high"{% else %} loading="lazy"{% endif %} decoding="async">
</picture>
{%- endmacro %}

{% macro header(contact, em, site, current="") %}
{%- set items = [
  { id: "boats", label: "Boat trips", href: "/tours/#boat-trips" },
  { id: "activities", label: "Activities", href: "/tours/#activities" },
  { id: "transfers", label: "Transfers", href: "/taxi/" },
  { id: "rental", label: "Rental", href: "/tours/rental/" }
] -%}
<header class="hd" data-hd>
  <div class="wrap">
    <a class="brand" href="/"><picture><source type="image/avif" srcset="{{ em.avif }}"><img eleventy:ignore src="{{ em.src }}" srcset="{{ em.webp }}" width="{{ em.width }}" height="{{ em.height }}" alt=""></picture><span><span class="brand-name">Secret Travel &amp; Tour</span><span class="brand-place">Sala Dan, Koh Lanta</span></span></a>
    <nav class="nav" aria-label="Main"><ul>{% for i in items %}<li><a href="{{ i.href }}"{% if i.id == current %} aria-current="page"{% endif %}>{{ i.label }}</a></li>{% endfor %}</ul></nav>
    <a class="btn hd-wa" href="{{ waHref(contact.number) }}">{{ icon("whatsapp") }}<span>WhatsApp</span></a>
    <button class="menu-btn" type="button" aria-haspopup="dialog" aria-controls="menu" data-menu-open>{{ icon("menu") }}<span class="sr-only">Menu</span></button>
  </div>
</header>
<dialog class="menu" id="menu" aria-label="Menu">
  <div class="menu-top">
    <a class="brand" href="/"><picture><source type="image/avif" srcset="{{ em.avif }}"><img eleventy:ignore src="{{ em.src }}" srcset="{{ em.webp }}" width="{{ em.width }}" height="{{ em.height }}" alt=""></picture><span><span class="brand-name">Secret Travel &amp; Tour</span><span class="brand-place">Sala Dan, Koh Lanta</span></span></a>
    <button class="menu-btn" type="button" data-menu-close>{{ icon("close") }}<span class="sr-only">Close menu</span></button>
  </div>
  <nav aria-label="Main"><ul>{% for i in items %}<li><a href="{{ i.href }}">{{ i.label }}</a></li>{% endfor %}</ul></nav>
  <div class="menu-foot">
    <p>{{ site.brands.secret.address.display }}</p>
    <a href="{{ waHref(contact.number) }}">WhatsApp {{ contact.phoneDisplay }}</a>
  </div>
</dialog>
{% endmacro %}

{#- Carte produit : toute la carte est le lien ; photo 4:3, titre, promesse, faits, prix. -#}
{% macro card(c, sizes="(min-width: 1024px) 380px, (min-width: 700px) 50vw, 100vw") %}
<a class="card" href="{{ c.href }}">
  <div class="card-media">{{ img(c.photo, sizes) }}</div>
  <div class="card-body">
    <h3 class="card-title">{{ c.title }}</h3>
    {% if c.promise %}<p class="card-promise">{{ c.promise }}</p>{% endif %}
    {% if c.facts %}<p class="card-facts">{{ c.facts }}</p>{% endif %}
    <p class="card-price">{% if c.price %}<span>from</span><b>{{ c.price.amount }}</b><span>{{ c.price.unit }}</span>{% else %}<b>Price on WhatsApp</b>{% endif %}</p>
  </div>
</a>
{% endmacro %}

{% macro cards(list, sizes) %}
<ul class="cards">{% for c in list %}<li>{{ card(c, sizes) if sizes else card(c) }}</li>{% endfor %}</ul>
{% endmacro %}

{#- Liste à filets : titre serif et une ligne grise ; lien si href. -#}
{% macro rules(items) %}
<ul class="rules">
  {%- for i in items %}
  <li>{% if i.href %}<a class="rule-link" href="{{ i.href }}">{% endif %}<span class="rule-title">{% if i.from %}{{ i.from }} <svg class="dir" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="sr-only">to</span> {{ i.to }}{% else %}{{ i.title }}{% endif %}</span>{% if i.text %}<span class="rule-text">{{ i.text }}</span>{% endif %}{% if i.href %}</a>{% endif %}</li>
  {%- endfor %}
</ul>
{% endmacro %}

{% macro faq(items) %}
<div class="rules faq">
  {%- for f in items %}
  <div><details><summary>{{ f.q }}<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 3v14M3 10h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></summary><p class="rule-text">{{ f.a }}</p></details></div>
  {%- endfor %}
</div>
{% endmacro %}

{% macro steps(list) %}
<ol class="steps">
  {%- for s in list %}<li><span class="step-n" aria-hidden="true">{{ loop.index }}</span><h3>{{ s.title }}</h3><p>{{ s.text }}</p></li>{% endfor %}
</ol>
{% endmacro %}

{#- Options et prix : chaque ligne ouvre la feuille avec l'option préremplie (booking.js, data-book). -#}
{% macro options(list) %}
<ul class="opts">
  {%- for o in list %}
  <li>
    <button class="opt" type="button" data-book="{{ o.id }}" aria-pressed="false" aria-label="Check availability for {{ o.title }}">
      <span><span class="opt-name">{{ o.title }}</span>{% if o.sub %}<span class="opt-sub">{{ o.sub }}</span>{% endif %}</span>
      <span class="opt-price"><b>{{ o.price }}</b>{{ o.unit }}</span>
      {%- if o.ages %}<span class="opt-ages">{{ o.ages }}</span>{% endif %}
    </button>
  </li>
  {%- endfor %}
</ul>
{% endmacro %}

{#- Déroulé : liste verticale, heure à gauche, lieu en serif et texte gris, trait vertical continu. -#}
{% macro day(steps, note) %}
<ol class="day">
  {%- for s in steps %}<li><span class="day-t">{{ s.t }}</span><span class="day-b"><strong>{{ s.title }}</strong><span>{{ s.text }}</span></span></li>{% endfor %}
</ol>
{%- if note %}<p class="day-note">{{ note }}</p>{% endif %}
{% endmacro %}

{#- Galerie : 1 grande photo et les autres en grille ; visionneuse plein écran au clic ; balayable sur mobile. -#}
{% macro gallery(photos, label) %}
<div class="gallery{% if photos.length == 4 %} gallery--4{% endif %}" data-gallery aria-label="{{ label }}" role="region">
  {%- for p in photos %}
  <button type="button" class="{% if loop.first %}g-big{% endif %}" data-view="{{ loop.index0 }}" data-full="{{ p.fallback or p.src }}" data-alt="{{ p.alt }}" aria-label="Open photo {{ loop.index }} of {{ photos.length }}">{{ img(p, "(min-width: 768px) 400px, 88vw" if not loop.first else "(min-width: 768px) 800px, 88vw") }}</button>
  {%- endfor %}
</div>
<p class="gallery-count" aria-live="polite"><span data-gallery-index>1</span> / {{ photos.length }}</p>
<dialog class="viewer" data-viewer aria-label="Photos">
  <figure><img eleventy:ignore src="" alt="" data-viewer-img></figure>
  <div class="viewer-bar"><button type="button" data-viewer-prev>Previous</button><span><span data-viewer-index>1</span> / {{ photos.length }}</span><button type="button" data-viewer-next>Next</button><button type="button" data-viewer-close>Close</button></div>
</dialog>
{% endmacro %}

{% macro mobileBar(price, label, href, option="") %}
<div class="mbar" data-mbar>
  <p class="mbar-price">{% if price %}<small>from</small><b>{{ price }}</b>{% else %}<b>{{ label }}</b>{% endif %}</p>
  <a class="btn" href="{{ href }}" data-book="{{ option }}">Check availability</a>
</div>
{% endmacro %}

{% macro waPill(contact) %}
<a class="wa-pill" href="{{ waHref(contact.number) }}">{{ icon("whatsapp") }}<span><b>Secret Travel &amp; Tour</b><small>{{ contact.phoneDisplay }}</small></span><span class="wa-dot" aria-hidden="true"></span></a>
{% endmacro %}

{% macro footer(site, contact, em, boats, activities) %}
{%- set b = site.brands.secret -%}
<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-col">
        <div class="foot-brand"><span class="pastille"><picture><source type="image/avif" srcset="{{ em.avif }}"><img eleventy:ignore src="{{ em.src }}" srcset="{{ em.webp }}" width="{{ em.width }}" height="{{ em.height }}" alt="" loading="lazy"></picture></span><span class="foot-name">Secret Travel &amp; Tour</span></div>
        <p>{{ b.address.display }}</p>
        {% if b.maps %}<a href="{{ b.maps }}">Open in Google Maps</a><br>{% endif %}
        <a href="{{ waHref(contact.number) }}">WhatsApp {{ contact.phoneDisplay }}</a>
      </div>
      <div><p class="foot-title">Boat trips</p><ul>{% for c in boats %}<li><a href="{{ c.href }}">{{ c.title }}</a></li>{% endfor %}</ul></div>
      <div><p class="foot-title">Activities</p><ul>{% for c in activities %}<li><a href="{{ c.href }}">{{ c.title }}</a></li>{% endfor %}</ul></div>
      <div><p class="foot-title">More</p><ul><li><a href="/taxi/">Private transfers</a></li><li><a href="/tours/speedboat/">Speedboat times</a></li><li><a href="/tours/rental/">Rental</a></li><li><a href="/credits/">Photo credits</a></li></ul></div>
    </div>
    <div class="foot-bottom">
      <span>© 2026 {{ site.operator.name }}</span>
      {% if b.licence %}<span>TAT licence {{ b.licence }}</span>{% endif %}
      <a href="/legal/">Legal</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a>
    </div>
  </div>
</footer>
{% endmacro %}
