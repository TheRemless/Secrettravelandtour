{#- Sections des pages produit v4 (src/_includes/components/v4-product.js), dans l'ordre de la 4 Islands :
    hero, options et prix, journée avec ses photos, infos pratiques en onglets (inclus, avant de réserver, questions),
    autres sorties.
    Importer avec : {% import "components/v4-product.njk" as vp %} -#}
{% import "components/v4.njk" as v4 %}

{% macro crumbs(items) %}
<nav class="wrap crumbs" aria-label="Breadcrumb"><ol>
  {%- for i in items %}<li>{% if loop.last %}<span aria-current="page">{{ i.label }}</span>{% else %}<a href="{{ i.href }}">{{ i.label }}</a>{% endif %}</li>{% endfor %}
</ol></nav>
{% endmacro %}

{#- Hero : titre, faits clés (durée, prise en charge), prix d'appel et bouton dans le premier écran du téléphone,
    puis l'accroche. Sans photo déclarée, la colonne de droite porte un autre contenu (cta). -#}
{% macro hero(t, c, fallback, book, cta="Choose a date", side="") %}
<section class="wrap phero{% if not t.hero %} phero--np{% endif %}" aria-labelledby="h1">
  <div class="phero__text">
    <h1 id="h1">{{ t.h1 }}</h1>
    {%- if t.keyFacts.length %}
    <dl class="keyf{% if t.kind == 'rental' or t.kind == 'speedboat' %} keyf--rows{% endif %}">{% for f in t.keyFacts %}<div><dt>{{ f.label }}</dt><dd>{{ f.value }}</dd></div>{% endfor %}</dl>
    {%- endif %}
    <div class="phero__buy">
      {%- if t.price %}
      <p class="price price--big"><span>from</span><b>{{ t.price.amount }}</b><span>{{ t.price.unit }}</span></p>
      {%- else %}
      <p class="price price--big price--req"><b>Price on WhatsApp</b></p>
      {%- endif %}
      <a class="btn btn--lg press" href="{{ fallback }}" data-book="{{ book }}" data-cta data-track="hero"{% if book %} data-book-sel{% endif %}>{{ cta }}</a>
    </div>
    <p class="lead">{{ t.lead }}</p>
    <a class="link phero__ask" href="{{ v4.waHref(c.number, t.ask) }}" data-track="hero_ask">Ask a question on WhatsApp</a>
  </div>
  {%- if t.hero %}
  <div class="phero__ph">{{ v4.photo(t.hero, "(min-width: 900px) 56vw, 100vw", true, "", "trip-photo") }}</div>
  {%- elif side %}
  <div class="phero__side">{{ side | safe }}</div>
  {%- endif %}
</section>
{% endmacro %}

{#- Une ligne de prix : libellé, montant, unité. Une ligne qui désigne un choix (cours, site) se choisit ici ;
    un supplément (Koh Kradan, plongée en plus) se coche ici. -#}
{% macro row(r, o) -%}
{%- if r.pick %}
<li><label class="prow prow--pick"><input type="radio" name="row-{{ o.id }}" value="{{ r.pick.value }}" data-pick-row="{{ r.name or r.label }}" data-choice="{{ r.pick.choice }}"><span>{{ r.label }}</span><span class="opts__amt"><b>{{ r.amount }}</b>{% if r.unit %} <small>{{ r.unit }}</small>{% endif %}</span></label></li>
{%- elif r.tick %}
<li><label class="prow prow--pick"><input type="checkbox" value="{{ r.name or r.label }}" data-addon><span>{{ r.label }}</span><span class="opts__amt"><b>{{ r.amount }}</b>{% if r.unit %} <small>{{ r.unit }}</small>{% endif %}</span></label></li>
{%- else %}
<li><span>{{ r.label }}</span><span class="opts__amt"><b>{{ r.amount }}</b>{% if r.unit %} <small>{{ r.unit }}</small>{% endif %}</span></li>
{%- endif %}
{%- endmacro %}

{% macro feeList(fees, noNote=false) -%}
<ul class="opts__fees">
  {%- for f in fees %}<li><span>{{ f.label }}{% if f.note and not noNote and (loop.first or fees[loop.index0 - 1].note != f.note) %}<small>{{ f.note }}</small>{% endif %}</span><span class="opts__amt"><b>{{ f.amount }}</b>{% if f.unit %} <small>{{ f.unit }}</small>{% endif %}</span></li>{% endfor %}
</ul>
{%- endmacro %}

{% macro feeBlock(fees, thai, cash) -%}
<div class="pfees">
  <h3>Not in the price{% if cash %}, paid in cash on the day{% endif %}</h3>
  {%- set n0 = fees[0].note -%}
  {%- set same = true -%}{% for f in fees %}{% if f.note != n0 %}{% set same = false %}{% endif %}{% endfor %}
  {#- « Cash » est déjà dans le titre : la note garde seulement le reste (« Paid to the ranger on the island »). -#}
  {%- set nc = (n0 | replace(r/^cash\b[,.]?\s*/i, "")) if (cash and n0) else n0 -%}
  {%- if same and n0 %}{% if nc %}<p class="pfees__note">{{ nc.charAt(0) | upper }}{{ nc.slice(1) }}</p>{% endif %}{{ feeList(fees, true) }}{% else %}{{ feeList(fees) }}{% endif %}
  {%- if thai.length %}<details class="pfees__thai"><summary>Thai nationals</summary>{{ feeList(thai) }}</details>{% endif %}
</div>
{%- endmacro %}

{#- Détail de l'option : faits propres, toutes ses lignes de prix, note, déroulé court, frais propres. -#}
{% macro detail(o) %}
<div class="po__detail" id="po-{{ o.id }}-d">
  {%- if o.photo %}{{ v4.photo(o.photo, "(min-width: 900px) 320px, 90vw", false, "po__ph") }}{% endif %}
  {%- if o.facts.length %}<dl class="po__facts">{% for f in o.facts %}<div><dt>{{ f[0] }}</dt><dd>{{ f[1] }}</dd></div>{% endfor %}</dl>{% endif %}
  {%- if o.onRequest %}
  {#- Sans prix d'appel, l'en-tête dit déjà « Price on WhatsApp ». -#}
  {%- if o.from %}<p class="po__req"><span>Price</span><b>Ask on WhatsApp</b></p>{% endif %}
  {%- else %}
  <ul class="opts__prices">{% for r in o.rows %}{{ row(r, o) }}{% endfor %}</ul>
  {%- endif %}
  {%- if o.note %}<p class="po__note">{{ o.note }}</p>{% endif %}
  {%- if o.what.length %}
  {%- if o.what.length > 2 %}<details class="po__more"><summary>What you do</summary>{% endif %}
  <div class="po__what">{% for w in o.what %}<p>{% if w.t %}<b>{{ w.t }}</b> {% endif %}{{ w.text }}</p>{% endfor %}</div>
  {%- if o.what.length > 2 %}</details>{% endif %}
  {%- endif %}
  {%- if o.fees.length %}{{ feeBlock(o.fees, o.thai, false) }}{% endif %}
</div>
{% endmacro %}

{#- Choisir et réserver : chaque option avec son prix d'appel, le détail de l'option choisie juste dessous, puis le
    groupe, le total estimé et le bouton. Sans JavaScript, les options restent des boutons radio (le détail suit le
    choix en CSS) et le bouton ouvre WhatsApp. Grille durée × ligne quand les options partagent leurs lignes (ATV, karts). -#}
{% macro pick(t, c) %}
{%- set pk = t.pick -%}
<section class="sec sec--sand pick-sec" id="options" aria-labelledby="opt-h">
  <div class="wrap pick">
    <div class="pick__main">
      <h2 id="opt-h">{{ pk.title }}</h2>
      {%- if pk.help %}<p class="pick__help">{{ pk.help }}</p>{% endif %}
      {%- if pk.when.length %}
      <dl class="pick__when">{% for w in pk.when %}<div><dt>{{ w.label }}</dt><dd>{{ w.value }}</dd></div>{% endfor %}</dl>
      {%- endif %}
      {%- if pk.matrix %}
      <fieldset class="pick__list pick__list--grid">
        <legend class="sr">Choose an option</legend>
        <table class="ptab">
          <caption class="sr">Prices in Thai baht, {{ pk.matrix.unit }}</caption>
          <thead><tr><th scope="col" class="ptab__u">THB {{ pk.matrix.unit }}</th>{% for o in pk.options %}<th scope="col"><label class="ptab__opt"><input type="radio" name="pick" value="{{ o.id }}"{% if o.id == pk.sel %} checked{% endif %}><span>{{ o.label }}</span></label></th>{% endfor %}</tr></thead>
          <tbody>
            {%- for rl in pk.matrix.rows %}{% set ri = loop.index0 %}
            {%- set rp = rl.split(", ") %}
            <tr><th scope="row">{{ rp[0] }}{% if rp[1] %}<small>{{ rp[1] }}</small>{% endif %}</th>{% for o in pk.options %}{% set r = o.rows[ri] %}<td data-col="{{ o.id }}"><b>{{ r.amount | replace(" THB", "") }}</b>{% if r.unit %} <small>{{ r.unit }}</small>{% endif %}</td>{% endfor %}</tr>
            {%- endfor %}
          </tbody>
        </table>
        {%- for o in pk.options %}
        <div class="po po--grid{% if o.photo %} po--ph{% endif %}" data-po="{{ o.id }}">{% if o.photo %}{{ v4.photo(o.photo, "(min-width: 900px) 200px, 40vw", false, "po__ph") }}{% endif %}{% if o.sub or o.note %}<p class="po__note">{% if o.sub %}{{ o.sub }}.{% endif %}{% if o.sub and o.note %} {% endif %}{{ o.note }}</p>{% endif %}</div>
        {%- endfor %}
      </fieldset>
      {%- else %}
      <fieldset class="pick__list">
        <legend class="sr">Choose an option</legend>
        {%- for g in pk.groups %}
        {%- if g.title %}<p class="pick__g">{{ g.title }}{% if g.sub %}<span>{{ g.sub }}</span>{% endif %}</p>{% endif %}
        {%- for o in g.options %}
        <div class="po" data-po="{{ o.id }}">
          <label class="po__head">
            <input type="radio" name="pick" value="{{ o.id }}"{% if o.id == pk.sel %} checked{% endif %}{% if pk.single %} hidden{% endif %} aria-controls="po-{{ o.id }}-d">
            <span class="po__name">{{ o.label }}{% if o.sub %}<small>{{ o.sub }}</small>{% endif %}</span>
            {%- if o.from %}
            <span class="po__from">{% if o.from.from %}<small>from</small> {% endif %}<b>{{ o.from.amount }}</b><small>{{ o.from.unit }}</small></span>
            {%- else %}
            <span class="po__from po__from--req"><small>Price on WhatsApp</small></span>
            {%- endif %}
          </label>
          {{ detail(o) }}
        </div>
        {%- endfor %}
        {%- endfor %}
      </fieldset>
      {%- endif %}
      {%- if pk.common.length %}{{ feeBlock(pk.common, pk.thai, pk.feesCash) }}{% endif %}
      {%- for x in pk.extra %}
      <details class="pick__extra">
        <summary>{{ x.label }}</summary>
        {%- if x.note %}<p class="po__note">{{ x.note }}</p>{% endif %}
        <ul class="opts__prices">{% for r in x.rows %}<li><span>{{ r.label }}</span><span class="opts__amt"><b>{{ r.amount }}</b>{% if r.unit %} <small>{{ r.unit }}</small>{% endif %}</span></li>{% endfor %}</ul>
      </details>
      {%- endfor %}
    </div>
    {{ calc(pk, c) }}
  </div>
</section>
{% endmacro %}

{#- Groupe et total : adultes et âge de chaque enfant, ou les compteurs propres à l'option (pilotes, karts). -#}
{% macro calc(pk, k) %}
{%- set cl = pk.calc -%}
<div class="calc" role="group" aria-labelledby="h-prices" data-calc>
  <h3 class="calc__h" id="h-prices">Your group</h3>
  <p class="calc__opt" data-calc-opt>{{ cl.selLabel }}</p>
  <div class="calc__gs">
    {%- if cl.mode == "counts" %}
    {%- for r in cl.countRows %}
    {%- set rp = r.split(", ") %}
    <div class="stp-row"><span><b id="c-n{{ loop.index0 }}">{{ rp[0] }}</b>{% if rp[1] %}<small id="c-n{{ loop.index0 }}s">{{ rp[1] }}</small>{% endif %}</span><span class="stp" role="group" aria-labelledby="c-n{{ loop.index0 }}{% if rp[1] %} c-n{{ loop.index0 }}s{% endif %}"><button type="button" data-step="n" data-i="{{ loop.index0 }}" data-d="-1" disabled>−<span class="sr">One less</span></button><output data-out="n{{ loop.index0 }}">0</output><button type="button" data-step="n" data-i="{{ loop.index0 }}" data-d="1">+<span class="sr">One more</span></button></span></div>
    {%- endfor %}
    {%- else %}
    <div class="stp-row"><span><b id="c-a">Adults</b>{% if cl.adultFrom %}<small>{{ cl.adultFrom }} and over</small>{% endif %}</span><span class="stp" role="group" aria-labelledby="c-a"><button type="button" data-step="adults" data-d="-1">−<span class="sr">One adult less</span></button><output data-out="adults">2</output><button type="button" data-step="adults" data-d="1">+<span class="sr">One adult more</span></button></span></div>
    <div class="stp-row"><span><b id="c-c">Children</b><small>0 to {{ cl.kidMax }}, we ask each age</small></span><span class="stp" role="group" aria-labelledby="c-c"><button type="button" data-step="children" data-d="-1" disabled>−<span class="sr">One child less</span></button><output data-out="children">0</output><button type="button" data-step="children" data-d="1">+<span class="sr">One child more</span></button></span></div>
    <div class="calc__ages" data-ages></div>
    <p class="calc__note" data-advice hidden></p>
    {%- endif %}
  </div>
  <div class="calc__total" aria-live="polite">
    <small data-calc-lbl>{% if cl.total %}Estimated total{% else %}Total{% endif %}</small>
    <b data-calc-sum{% if not cl.total %} hidden{% endif %}><span class="odo" data-odo="total">{{ cl.total | replace(" THB", "") }}</span> THB</b>
    <p class="calc__confirm" data-calc-confirm{% if cl.total %} hidden{% endif %}>{% if cl.mode == "counts" %}Add who is coming to see the total.{% else %}We confirm the total on WhatsApp.{% endif %}</p>
    <ul class="calc__lines" data-calc-lines>{% for l in cl.lines %}<li><span>{{ l.label }}</span><span>{{ l.amount }}</span></li>{% endfor %}</ul>
    <p class="calc__note" data-calc-unpriced hidden></p>
    <p class="calc__note calc__cash" data-calc-cash hidden></p>
  </div>
  <a class="btn btn--lg press" href="{{ v4.waHref(k.number, cl.fallback) }}" data-book="{{ pk.sel }}" data-book-sel data-calc-book data-track="price_calculator">Choose a date</a>
</div>
<script type="application/json" id="pick-data">{{ pk.json | dump | safe }}</script>
{% endmacro %}

{#- Photos de la fiche (splitPhotos de v4data.js) : une vignette par photo, numérotée pour la visionneuse.
    Cinq photos : la grande et quatre petites ; deux ou trois : côte à côte, chacune à sa proportion (--ar) ;
    téléphone : bande à faire glisser. Chaque vignette est un lien vers la photo entière (sans JavaScript). -#}
{% macro mosaic(items, start, total, big="(min-width: 900px) 600px, 72vw", small="(min-width: 900px) 300px, 72vw") %}
<div class="mos mos--{{ 5 if items.length >= 5 else items.length }}">
  {%- for p in items %}
  {%- set ar = (p.width / p.height) if (p.width and p.height) else 1.33 %}{% if ar > 2.2 %}{% set ar = 2.2 %}{% elif ar < 0.6 %}{% set ar = 0.6 %}{% endif %}
  <a class="gal__item press" href="{{ p.fallback or p.src }}" data-gal-i="{{ start + loop.index0 }}" data-full="{{ p.fallback or p.src }}" data-w="{{ p.width }}" data-h="{{ p.height }}" style="--ar: {{ ar | round(2) }}" aria-label="Open photo {{ start + loop.index }} of {{ total }}: {{ p.alt }}">{{ v4.photo(p, big if loop.first else small) }}</a>
  {%- endfor %}
</div>
{% endmacro %}

{#- Journée : faits du lieu, photos, puis chaque journée minutée en ligne de temps (en colonne sur téléphone, trois
    étapes et « Show the whole day »). Plusieurs journées : celle de l'option choisie (v4-product.js) ; deux journées
    pour les mêmes options (cours du midi et du soir) : un bouton choisit laquelle. Sous la journée d'un cours, son menu
    jour par jour. Sans journée, les photos seules en bande. -#}
{% macro day(t, ph) %}
{%- set pg = t.programme -%}
{%- set seg = pg.seg -%}
<section class="sec sec--sand trip" id="day" aria-labelledby="day-h"><div class="wrap">
  <div class="trip__head">
    <div class="trip__t">
      <h2 id="day-h">{{ pg.title }}</h2>
      {%- if t.sideFacts.length %}
      <dl class="facts">{% for f in t.sideFacts %}<div><dt>{{ f.label }}</dt><dd>{{ f.value }}</dd></div>{% endfor %}</dl>
      {%- endif %}
    </div>
    {%- if seg %}
    <div class="seg trip__seg" role="group" aria-label="Choose the class" data-day-seg hidden>
      {%- for b in pg.blocks %}<button type="button" data-day-btn="{{ loop.index0 }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ b.title.split(':')[0] }}</button>{% endfor %}
    </div>
    {%- endif %}
  </div>
  {%- if ph and ph.mos.length %}<div class="trip__media">{{ mosaic(ph.mos, 0, ph.all.length) }}</div>{% endif %}
  {%- for b in pg.blocks %}
  <div class="dayb" data-day-ids="{{ b.ids | join(' ') }}" data-day-i="{{ loop.index0 }}">
    {%- if b.title or b.note %}
    <div class="dayb__h">{% if b.title %}<h3 class="day__for">{{ b.title }}</h3>{% endif %}{% if b.note %}<p class="day__note">{{ b.note }}</p>{% endif %}</div>
    {%- endif %}
    <ol class="route route--{{ b.steps.length }}">
      {%- for s in b.steps %}
      <li class="route__step">{% if s.t %}<time class="{{ 'fixed' if s.fixed }}">{% if s.approx %}≈ {% endif %}{{ s.t }}</time>{% endif %}<p>{{ s.text }}</p></li>
      {%- endfor %}
    </ol>
    <button type="button" class="route__more" data-more hidden>Show the whole day</button>
    {%- if b.menu %}
    <div class="menu">
      <h3 class="menu__q">{{ b.menu.q }}</h3>
      <div class="menu__days">{% for d in b.menu.days %}<div class="menu__d"><h4>{{ d.day }}</h4><ul>{% for x in d.items %}<li>{{ x }}</li>{% endfor %}</ul></div>{% endfor %}</div>
    </div>
    {%- endif %}
  </div>
  {%- endfor %}
</div></section>
{% endmacro %}

{% macro photoBand(ph, name, sand=true) %}
<section class="sec{% if sand %} sec--sand{% endif %} trip trip--ph" aria-label="Photos of {{ name }}"><div class="wrap">{{ mosaic(ph.mos, 0, ph.all.length) }}</div></section>
{% endmacro %}

{#- Infos pratiques : ce que couvre le prix, avant de réserver, questions. Bureau : onglets, le premier ouvert, les
    photos restantes à gauche ; téléphone : volets, le premier ouvert ; sans JavaScript, les blocs l'un sous l'autre.
    Un seul bloc : ni onglets ni volets. -#}
{% macro know(t, ph) %}
{%- set inc = (t.included and t.included.length) or (t.notIncluded and t.notIncluded.length) or t.includedGroups -%}
{%- set panels = [] -%}
{%- if inc %}{% set panels = panels.concat([["inc", "What the price covers"]]) %}{% endif -%}
{%- if t.beforeBook and t.beforeBook.length %}{% set panels = panels.concat([["byb", "Before you book"]]) %}{% endif -%}
{%- if t.faq and t.faq.length %}{% set panels = panels.concat([["faq", "Questions"]]) %}{% endif -%}
{%- set side = ph.side if ph else [] -%}
{%- if panels.length %}
<section class="sec know{% if not side.length %} know--wide{% endif %}" aria-labelledby="{{ panels[0][0] }}-h"><div class="wrap know__in">
  {%- if side.length %}
  <div class="know__ph know__ph--n{{ side.length if side.length < 3 else 2 }}">
    {%- for p in side %}
    <a class="gal__item press" href="{{ p.fallback or p.src }}" data-gal-i="{{ ph.start + loop.index0 }}" data-full="{{ p.fallback or p.src }}" data-w="{{ p.width }}" data-h="{{ p.height }}" aria-label="Open photo {{ ph.start + loop.index }} of {{ ph.all.length }}: {{ p.alt }}">{{ v4.photo(p, "(min-width: 900px) 380px, 45vw") }}</a>
    {%- endfor %}
  </div>
  {%- endif %}
  <div class="know__main"{% if panels.length > 1 %} data-tabs{% endif %}>
    {%- if panels.length > 1 %}
    <div class="tabs" role="tablist" aria-label="Practical details" hidden>
      {%- for p in panels %}<button type="button" role="tab" id="tab-{{ p[0] }}" aria-controls="p-{{ p[0] }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ p[1] }}</button>{% endfor %}
    </div>
    {%- endif %}
    {%- for p in panels %}
    <div class="panel" id="p-{{ p[0] }}">
      <h2 class="panel__h" id="{{ p[0] }}-h">{% if panels.length > 1 %}<button type="button" class="panel__t" aria-expanded="true" aria-controls="p-{{ p[0] }}-b">{{ p[1] }}</button>{% else %}{{ p[1] }}{% endif %}</h2>
      <div class="panel__b" id="p-{{ p[0] }}-b">
      {%- if p[0] == "inc" %}
        <div class="inc2">
        {%- if t.includedGroups %}<div class="inc2__col"><h3>Included</h3>{% for g in t.includedGroups %}<h4 class="inc__for">{{ g.label }}</h4><ul class="inc2__list">{% for x in g.items %}<li{% if x.indexOf("On a private boat") == 0 %} data-private{% endif %}>{{ x }}</li>{% endfor %}</ul>{% endfor %}</div>
        {%- elif t.included.length %}<div class="inc2__col"><h3>Included</h3><ul class="inc2__list">{% for x in t.included %}<li{% if x.indexOf("On a private boat") == 0 %} data-private{% endif %}>{{ x }}</li>{% endfor %}</ul></div>{% endif %}
        {%- if t.notIncluded.length %}<div class="inc2__col"><h3>Not included</h3><ul class="inc2__list">{% for x in t.notIncluded %}<li>{{ x }}</li>{% endfor %}</ul></div>{% endif %}
        </div>
      {%- elif p[0] == "byb" %}
        <dl class="byb2">{% for b in t.beforeBook %}<div><dt>{{ b.label }}</dt><dd>{{ b.text }}{% if b.href %} <a class="link" href="{{ b.href }}">{{ b.hrefLabel }}</a>{% endif %}</dd></div>{% endfor %}</dl>
      {%- else %}
        <div class="faq faq2">{% for f in t.faq %}<details><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>{% endfor %}</div>
      {%- endif %}
      </div>
    </div>
    {%- endfor %}
  </div>
</div></section>
{%- endif %}
{% endmacro %}

{#- Avant de réserver et questions en une section (page des transferts) ; variant « compact » : rubriques serrées, sur
    deux colonnes au bureau. Les fiches de sorties ont la macro know. -#}
{% macro bybFaq(byb, faq, variant="") %}
<section class="sec sec--sand{% if variant %} byb-sec--{{ variant }}{% endif %}" aria-labelledby="{{ 'byb-h' if byb.length else 'faq-h' }}">
  <div class="wrap">
    {%- if byb.length %}<div class="byb"><h2 id="byb-h">Before you book</h2><dl>{% for b in byb %}<div><dt>{{ b.label }}</dt><dd>{{ b.text }}{% if b.href %} <a class="link" href="{{ b.href }}">{{ b.hrefLabel }}</a>{% endif %}</dd></div>{% endfor %}</dl></div>{% endif %}
    {%- if faq.length %}<div class="byb faq{% if not byb.length %} faq--first{% endif %}"><h2 id="faq-h">Questions</h2><div>{% for f in faq %}<details><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>{% endfor %}</div></div>{% endif %}
  </div>
</section>
{% endmacro %}

{#- variant « list » : cartes horizontales compactes (une seule carte sur le speedboat), pas de rail. -#}
{% macro related(r, variant="") %}
{%- if r %}
<section class="sec" aria-labelledby="rel-h" data-track="related">
  <div class="wrap">
    <div class="sec__head"><h2 id="rel-h">{{ r.title }}</h2>{% if r.all %}<a class="link" href="{{ r.all.href }}">{{ r.all.label }}</a>{% endif %}</div>
    {%- if r.cards.length and variant == "list" %}<div class="grid grid--rel">{% for x in r.cards %}{{ v4.card(x, add=false) }}{% endfor %}</div>
    {%- elif r.cards.length %}<div class="rail rail--rel" role="region" tabindex="0" aria-label="{{ r.title }}, one card after the other">{% for x in r.cards %}{{ v4.card(x) }}{% endfor %}</div>{% endif %}
    {%- if r.transfer %}<p class="also">Arriving at {{ r.transfer.from }}? <a class="link" href="{{ r.transfer.href }}">See the {{ r.transfer.name }} transfer</a></p>{% endif %}
    {%- if r.links.length %}<ul class="also also--list">{% for l in r.links %}<li><a class="link" href="{{ l.href }}">{{ l.label }}</a></li>{% endfor %}</ul>{% endif %}
  </div>
</section>
{%- endif %}
{% endmacro %}

{#- Bande du bas (téléphone seulement) : prix d'appel et bouton dès l'arrivée ; une fois le groupe choisi, l'option et
    le total. Elle s'efface devant le bloc de réservation, le pied de page et la feuille (v4-product.js). -#}
{% macro dock(price, fallback, book, label="Choose a date") %}
<div class="dock" data-dock role="region" aria-label="Book" data-track="dock">
  {%- if price %}<p class="dock__p" data-dock-p><span>from {{ price.amount }}</span><small>{{ price.unit }}</small></p>{% else %}<p class="dock__p" data-dock-p><span class="dock__req">Price on WhatsApp</span></p>{% endif %}
  <button class="dock__trips" type="button" data-trips-open data-track-cta="trip_list_open" aria-haspopup="dialog" hidden>{{ v4.glyph("list") }}<span data-trips-count>0</span><span class="sr"> in your trip list</span></button>
  <a class="btn press" href="{{ fallback }}" data-book="{{ book }}"{% if book %} data-book-sel{% endif %} data-dock-book data-track="dock">{{ label }}</a>
</div>
{% endmacro %}
