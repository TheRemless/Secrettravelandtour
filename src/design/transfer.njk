---
boardPermalink: /design/transfer/
---
{#- Transfert en minivan, habillage Secret : sert à montrer la feuille en version transfert (point 17). Jamais en production. -#}
{% import "components/stt.njk" as stt %}
{% from "components/booking.njk" import bookingSheet %}
{%- set t = transferPage -%}
{%- set fallback = stt.waHref(boardContact.number, t.fallback) -%}
<!DOCTYPE html>
<html lang="en-GB" data-board>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<title>Minivan transfers, design board</title>
{% include "board-head-stt.njk" %}
</head>
<body class="has-mbar">
<a class="skip" href="#main">Skip to content</a>
{{ stt.header("transfers", boardContact, emblem.header, site) }}
<main id="main" class="wrap">
  {{ stt.breadcrumb([{ label: "Home", href: "/" }, { label: "Transfers" }]) }}
  <div class="grid pg-head">
    <h1 class="c-8">{{ t.h1 }}</h1>
    <p class="lead c-7">{{ t.lead }}</p>
  </div>
  <div class="grid">
    <section class="pg-sec c-8" id="prices" aria-labelledby="h-prices">
      <h2 id="h-prices">Shared or private</h2>
      {{ stt.optionsPrices(t.options) }}
    </section>
  </div>
</main>
{{ stt.footer(site, boardContact, emblem.footer) }}
{{ stt.mobileBar(null, fallback) }}
{{ bookingSheet(t.booking, boardContact) }}
<script src="/js/booking.js?v={{ build.v }}" defer></script>
<script src="/js/ui.js?v={{ build.v }}" defer></script>
{% include "board-tools.njk" %}
</body>
</html>
