---
permalink: /taxi/
eleventyExcludeFromCollections: true
---
{#- Hub de VIP Taxi Lanta (Mr. Brown), identité « Laque et or » (choix de Jérémy, 10.11.2026).
    Marque à part de Secret : pas de header ni de footer Secret. La réservation passe par la feuille
    (booking.js, variante taxi, From et To libres) qui rédige un message WhatsApp pour Anaïs.
    Les anciens liens /taxi/?from=…&to=… et /taxi/#request ouvrent la feuille préremplie (vip-taxi.js). -#}
{% import "components/taxi.njk" as tx %}
{% from "components/booking.njk" import bookingSheet %}
{%- set T = taxiPages -%}
{%- set h = taxi.hero -%}
{%- set fallback = tx.waHref(T.contact.number, "Transfer request") -%}
<!DOCTYPE html>
<html lang="en-GB" data-refonte data-brand="vip">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Minivan Transfers &amp; Taxi, Southern Thailand | VIP Taxi Lanta</title>
<meta name="description" content="Private minivan transfers across Southern Thailand and taxis on Koh Lanta: Krabi, Phuket, Surat Thani, Khao Lak and Trang. Request a price on WhatsApp.">
<meta name="robots" content="index, follow, max-image-preview:large">
<link rel="canonical" href="{{ site.url }}/taxi/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="VIP Taxi Lanta">
<meta property="og:url" content="{{ site.url }}/taxi/">
<meta property="og:title" content="Minivan Transfers &amp; Taxi, Southern Thailand | VIP Taxi Lanta">
<meta property="og:description" content="Private minivan transfers across Southern Thailand and taxis on Koh Lanta. Request a price on WhatsApp.">
<meta property="og:image" content="{{ site.url }}/images/taxi/og-taxi.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="VIP Taxi Lanta, Mr. Brown, private taxis and minivans">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" sizes="32x32" href="/images/taxi/icon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/images/taxi/apple-touch-icon.png">
<meta name="theme-color" content="#1B130D">
<link rel="preload" as="font" type="font/woff2" href="/css/fonts/chonburi-400-normal-latin.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/css/fonts/bai-jamjuree-400-normal-latin.woff2" crossorigin>
<link rel="stylesheet" href="/css/booking.css?v={{ build.v }}">
<link rel="stylesheet" href="/css/vip-taxi.css?v={{ build.v }}">
<script>document.documentElement.classList.add("js");</script>
<script type="application/ld+json">{{ taxiView.jsonLd | dump | safe }}</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{{ tx.top(T.contact) }}
<main id="main">
<section class="hero" aria-labelledby="h1">
  <div class="wrap hero-in">
    <h1 id="h1">{{ h.title }}</h1>
    {{ tx.arch(h.photo.src, h.photo.alt, h.photo.width, h.photo.height, srcset=h.photo.srcset, sizes="(min-width: 64rem) 40vw, 92vw", priority=true) }}
    <div class="hero-text">
      <p class="lead">{{ h.lead }}</p>
      <div class="hero-act">
        <a class="btn btn--gold" href="{{ fallback }}" data-book="">Request a transfer</a>
        <a class="link-lac" href="#routes">See all routes</a>
      </div>
    </div>
  </div>
</section>

<section class="routes" id="routes" aria-labelledby="h-routes">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="h-routes">Everywhere in Southern Thailand</h2>
      <p>Every route runs both ways, in a private minivan.</p>
    </div>
    <div class="regions">
      {%- for g in T.regions %}
      <section class="region" aria-labelledby="rg-{{ loop.index }}">
        <h3 id="rg-{{ loop.index }}">{{ g.name }}</h3>
        <p class="region-intro">{{ g.intro }}</p>
        <ul class="rr-list">{% for r in g.routes %}{{ tx.routeRow(r) }}{% endfor %}</ul>
      </section>
      {%- endfor %}
      <div class="elsewhere">
        <div>
          <h3>Not on the list?</h3>
          <p>{{ T.further }}</p>
        </div>
        <a class="btn btn--lac" href="{{ fallback }}" data-book="">Ask for another route</a>
      </div>
    </div>
  </div>
</section>

<section class="book" aria-labelledby="h-book">
  <div class="wrap book-in">
    <div class="book-how">
      <h2 id="h-book">How to book</h2>
      <ol class="steps">
        {%- for s in taxi.steps %}
        <li><p class="step-t">{{ s.title }}</p><p>{{ s.text }}</p></li>
        {%- endfor %}
      </ol>
    </div>
    <div class="book-side">
      <div class="pay" data-frame="still">
        <h3>Payment</h3>
        <p>{{ taxi.payment.text }}</p>
      </div>
      {%- if T.rating %}
      <a class="rating" href="{{ T.rating.url }}">
        <span class="stars" aria-hidden="true">{% for i in range(0, 5) %}<svg viewBox="0 0 24 24" focusable="false"><path fill="currentColor" d="M12 2.6l2.8 6 6.5.7-4.9 4.4 1.4 6.4L12 16.8l-5.8 3.3 1.4-6.4-4.9-4.4 6.5-.7z"/></svg>{% endfor %}</span>
        <span class="rating-t">Rated {{ T.rating.value }} on Google<small>{{ T.rating.count }} reviews on Google Maps</small></span>
      </a>
      {%- endif %}
    </div>
  </div>
</section>

<section class="van" aria-labelledby="h-van">
  {%- set g = taxi.gallery.photos -%}
  <div class="wrap van-in">
    <figure class="van-wide"><img eleventy:ignore src="{{ g[0].src }}" width="{{ g[0].width }}" height="{{ g[0].height }}" loading="lazy" decoding="async" alt="{{ g[0].alt }}"></figure>
    <div class="van-text">
      <h2 id="h-van">{{ taxi.gallery.title }}</h2>
      <dl class="why">
        {%- for w in taxi.why %}
        <div><dt>{{ w.title }}</dt><dd>{{ w.text }}</dd></div>
        {%- endfor %}
      </dl>
    </div>
    <figure class="van-in-photo"><img eleventy:ignore src="{{ g[2].src }}" width="{{ g[2].width }}" height="{{ g[2].height }}" loading="lazy" decoding="async" alt="{{ g[2].alt }}"></figure>
  </div>
</section>

<section class="qa" aria-labelledby="h-faq">
  <div class="wrap qa-in">
    <h2 id="h-faq">Questions</h2>
    {#- Déjà dit plus haut : le paiement (bloc Payment) et le privé (« Private only »). -#}
    {%- set skip = ["How do I pay?", "Is the transfer private?"] -%}
    {%- set faqs = [] -%}
    {%- for f in taxi.faq %}{% if f.q not in skip %}{% set _x = faqs.push(f) %}{% endif %}{% endfor %}
    {{ tx.faq(faqs) }}
  </div>
</section>

{{ tx.secretAside(taxi.tours) }}
</main>
{{ tx.footer(site, T.contact) }}
{{ tx.vbar("Request a transfer", fallback) }}
{{ bookingSheet(T.hubBooking, T.contact) }}
<script type="application/json" id="taxi-places">{{ taxi.places | dump | safe }}</script>
<script src="/js/booking.js?v={{ build.v }}" defer></script>
<script src="/js/vip-taxi.js?v={{ build.v }}" defer></script>
</body>
</html>
